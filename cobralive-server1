            <label>Portrait — من الأعلى<input id="portTop" type="number" value="24"></label>
            <label>Portrait — من اليمين<input id="portRight" type="number" value="24"></label>
            <label>Portrait — العرض<input id="portWidth" type="number" value="120"></label>
            <label>Landscape — من الأعلى<input id="landTop" type="number" value="24"></label>
            <label>Landscape — من اليمين<input id="landRight" type="number" value="24"></label>

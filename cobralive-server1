isplay:block;color:var(--muted);font-size:10px}.next-box strong{display:block;margin:3px 0}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:0 20px}.stats div{background:#0d0c12;border:1px solid var(--line);padding:12px;border-radius:10px;text-align:center}.stats b{display:block;font-size:18px}.stats small{color:var(--muted);font-size:9px}.section-title{font-weight:800;margin:26px 0 12px}.cards-4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.metric{padding:16px}.metric span,.metric small{display:block;color:var(--muted);font-size:11px}.metric b{display:block;margin:8px 0;font-size:17px}.ok{color:var(--green)}.form-card{padding:18px}.form-card.wide{max-width:100%}.form-card .panel-head{padding:0 0 15px;margin-bottom:15px}.form-card label{display:block;font-size:11px;color:#bbb4c3;margin:12px 0}.form-card input,.form-card textarea,.form-card select,.search{width:100%;margin-top:6px;background:#0b0a0f;color:#fff;border:1px solid var(--line);border-radius:9px;padding:10px;outline:none}.form-card input:focus,.form-card textarea:focus,.form-card select:focus,.search:focus{border-color:#7d4c94}.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}.switch-row{display:flex!important;justify-content:space-between;align-items:center}.switch-row input{display:none}.switch-row i{width:40px;height:22px;border-radius:20px;background:#302b36;position:relative}.switch-row i:after{content:'';position:absolute;width:16px;height:16px;top:3px;right:3px;background:#aaa;border-radius:50%;transition:.2s}.switch-row input:checked+i{background:var(--pink)}.switch-row input:checked+i:after{right:21px;background:#fff}.poster-preview{height:260px;border-radius:12px;background:#0b0a0f;border:1px dashed #3b3542;display:grid;place-items:center;overflow:hidden;color:var(--muted)}.poster-preview img{width:100%;height:100%;object-fit:cover}.preview-meta{padding-top:12px}.preview-meta small{display:block;color:var(--muted)}.media-list,.simple-list{display:grid;gap:9px}.media-item,.simple-item{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;background:#121018;border:1px solid var(--line);border-radius:11px}.media-item img{width:58px;height:42px;object-fit:cover;border-radius:7px;margin-left:10px}.media-info{display:flex;align-items:center;flex:1}.muted{color:var(--muted);font-size:10px}.badge{font-size:9px;padding:4px 7px;border:1px solid #9c4dff55;color:#c99cff;border-radius:5px}.playlist-editor{padding:14px}.playlist-row{display:grid;grid-template-columns:40px 1fr 130px 100px;gap:10px;align-items:center;padding:10px;border:1px solid var(--line);border-radius:10px;margin-bottom:8px;background:#0d0c12}.drag{color:var(--muted);text-align:center}.playlist-row input{background:#0b0a0f;border:1px solid var(--line);color:#fff;padding:8px;border-radius:7px}.info-card{padding:18px}.flow{display:flex;align-items:center;justify-content:center;gap:12px;margin:40px 0;font-size:12px}.flow b{padding:12px 16px;border:1px solid var(--line);border-radius:9px}.flow i{color:var(--pink)}.info-card p{color:var(--muted);font-size:12px;line-height:2}.emergency-panel{padding:25px;display:flex;justify-content:space-between;align-items:center;border-color:#ff3d5a55;background:linear-gradient(90deg,#1b0d14,#110f16)}.emergency-panel h2{margin:8px 0 3px}.emergency-panel p{color:var(--muted);margin:0;font-size:12px}.danger-badge{color:#ff8b99;border-color:#ff3d5a66}.emergency-btn{background:linear-gradient(135deg,#ff244b,#b20d30);border:0;color:#fff;padding:18px 30px;border-radius:12px;font-weight:800;box-shadow:0 0 30px #ff244b33}.big-status{min-height:150px;display:grid;place-items:center;color:var(--muted)}.user-table{padding:12px}.thead,.tbody>div{display:grid;grid-template-columns:1.2fr 1fr 1.5fr 100px;gap:10px;padding:12px;border-bottom:1px solid var(--line);font-size:11px}.thead{color:var(--muted)}.empty{padding:25px;color:var(--muted);text-align:center}.search{max-width:280px;margin:0}.toast{position:fixed;left:25px;bottom:25px;background:#19151f;border:1px solid #493d55;color:#fff;padding:11px 15px;border-radius:10px;opacity:0;transform:translateY(10px);transition:.25s;z-index:20}.toast.show{opacity:1;transform:none}@media(max-width:900px){.sidebar{width:210px}.main{margin-right:210px;width:calc(100% - 210px);padding:18px}.hero-grid,.form-grid{grid-template-columns:1fr}.cards-4{grid-template-columns:1fr 1fr}}@media(max-width:650px){.sidebar{position:static;width:100%;height:auto}.app-shell{display:block}.main{margin:0;width:100%}nav{grid-template-columns:1fr 1fr}.side-footer{display:none}.topbar{align-items:flex-start}.two,.cards-4{grid-template-columns:1fr}.playlist-row{grid-template-columns:25px 1fr}.playlist-row input:last-child{grid-column:2}.user-table{overflow:auto}}
  </style>
  <script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/11.10.0/firebase-app.js";
import { getFirestore, doc, getDoc, setDoc, onSnapshot, collection, query, orderBy, limit, getDocs, serverTimestamp, addDoc, deleteDoc } from "https://www.gstatic.com/firebasejs/11.10.0/firebase-firestore.js";

const firebaseConfig = {
  apiKey: "AIzaSyAwFgc1LrsO8xwJM6CJJYOnUSZHyWfkc",
  authDomain: "cobralive-server1.firebaseapp.com",
  projectId: "cobralive-server1",
  storageBucket: "cobralive-server1.firebasestorage.app",
  messagingSenderId: "874231764707",
  appId: "1:874231764707:web:256fc4ad2e1420fa89d7d6",
  measurementId: "G-P3B990Y934"
};

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);
const streamRef = doc(db, "streams", "live_stream_1");

const $ = id => document.getElementById(id);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
const toast = msg => { $("toast").textContent=msg; $("toast").classList.add("show"); setTimeout(()=>$("toast").classList.remove("show"),2200); };
const fmt = sec => { sec=Math.max(0,Math.floor(sec||0)); return String(Math.floor(sec/60)).padStart(2,"0")+":"+String(sec%60).padStart(2,"0"); };

const screens = {
 dashboard:["غرفة التحكم الرئيسية","تحكم مباشر في البث والمحتوى"],
 movies:["إدارة الأفلام","إضافة المحتوى وإدارة المكتبة"],
 playlist:["قائمة البث","ترتيب المحتوى وتحديد ما يعرض الآن"],
 ads:["فواصل الإعلانات","إدارة الفواصل واستكمال الفيلم من نفس الموضع"],
 emergency:["الإعلانات الطارئة","إرسال إعلان فوري إلى التطبيق"],
 branding:["شعار القناة","تحكم منفصل للـ Portrait والـ Landscape"],
 banners:["البانرات","Top / Bottom broadcast graphics"],
 prayer:["الصلاة والأذان","إعدادات مواقيت الصلاة والتنبيهات"],
 users:["الحسابات والتعليقات","إدارة الحسابات والتعليقات"]
};

document.querySelectorAll(".nav-item").forEach(btn=>{
  btn.onclick=()=>{
    document.querySelectorAll(".nav-item").forEach(x=>x.classList.remove("active"));
    btn.classList.add("active");
    document.querySelectorAll(".screen").forEach(x=>x.classList.remove("active"));
    $("screen-"+btn.dataset.screen).classList.add("active");
    $("screenTitle").textContent=screens[btn.dataset.screen][0];
    $("screenSubtitle").textContent=screens[btn.dataset.screen][1];
    if(btn.dataset.screen==="users") loadComments();
  };
});

function clock(){ $("clock").textContent=new Date().toLocaleTimeString("ar-EG",{hour12:false}); }
setInterval(clock,1000); clock();

let stream = {};
let playlist = [];

const normalizeAge = (value, legacy18=false) => {
  const v = String(value ?? "").trim();
  if (v) return v.startsWith("+") ? v : "+" + v;
  return legacy18 ? "+18" : "";
};

const normalizeItem = (m={}) => ({
  title: String(m.title ?? ""),
  url: String(m.url ?? ""),
  pageUrl: String(m.pageUrl ?? ""),
  durationSec: Math.max(1, Number(m.durationSec ?? 0) || 1),
  kind: String(m.kind ?? "MOVIE").toUpperCase(),
  ageRating: normalizeAge(m.ageRating ?? m.rating, !!m.is18Plus),
  posterUrl: String(m.posterUrl ?? ""),
  bannerUrl: String(m.bannerUrl ?? ""),
  category: String(m.category ?? "عام"),
  description: String(m.description ?? ""),
  skipStartSec: Math.max(0, Number(m.skipStartSec ?? 0) || 0),
  skipEndSec: Math.max(0, Number(m.skipEndSec ?? 0) || 0)
});

onSnapshot(streamRef, (snap) => {
  if (snap.exists()) {
    stream = snap.data();
    playlist = Array.isArray(stream.playlist) ? stream.playlist.map(normalizeItem) : [];
    renderStream();
    renderPlaylist();
    renderMovies();
    renderAds();
  }
}, (e) => {
  console.error(e);
  toast("خطأ في قراءة Firebase: " + e.message);
});

async function loadStream(){
  try{
    const snap=await getDoc(streamRef);
    if(snap.exists()){
      stream=snap.data();
      playlist=Array.isArray(stream.playlist)?stream.playlist.map(normalizeItem):[];
      renderStream();
      renderPlaylist();
      renderMovies();
      renderAds();
    }
  }catch(e){ console.error(e); toast("خطأ في قراءة Firebase: "+e.message); }
}

function renderStream(){
  const title=stream.movieTitle || stream.title || playlist[0]?.title || "لا يوجد محتوى";
  const cat=stream.movieCategory || stream.category || playlist[0]?.category || "—";
  const desc=stream.movieDescription || stream.description || playlist[0]?.description || "";
  const poster=stream.posterUrl || stream.moviePoster || playlist[0]?.posterUrl || "";
  $("dashTitle").textContent=title; $("nowTitle").textContent=title;
  $("dashCategory").textContent=cat; $("dashDescription").textContent=desc;
  if(poster) $("dashPoster").src=poster;
  $("viewerCount").textContent=Number(stream.viewers||0).toLocaleString("en-US");
  $("likeCount").textContent=Number(stream.likes||0).toLocaleString("en-US");
  $("playlistCount").textContent=playlist.length;
  $("playState").textContent=stream.playbackState||"PLAYING";
  $("bannerState").textContent=(stream.topBannerUrl||"")?"مفعل":"غير مفعل";
  $("dashNextMetric").textContent=playlist[1]?.title||"—";
  $("nextTitle").textContent=playlist[1]?.title||"لا يوجد";
  $("duration").textContent=fmt(playlist[0]?.durationSec || stream.durationSec || 0);
  const url=stream.bannerUrl || stream.movieBannerUrl || stream.backdropUrl || poster;
  if(url) $("dashPoster").src=url;
}

function renderMovies(){
  const list=$("movieList");
  if(!playlist.length){list.innerHTML='<div class="empty">لا توجد عناصر داخل playlist حالياً. أضف محتوى ثم احفظ قائمة البث.</div>';return}
  list.innerHTML=playlist.map((m,i)=>`<div class="media-item">
    <div class="media-info">${m.posterUrl?`<img src="${esc(m.posterUrl)}">`:""}<div>
      <b>${esc(m.kind)} ${i+1} — ${esc(m.title||"بدون اسم")}</b>
      <small class="muted">${esc(m.category||"")} · ${fmt(m.durationSec)} · ${esc(m.ageRating||"عام")}</small>
      ${m.pageUrl?`<br><small class="muted" style="color:var(--pink)">السورس: ${esc(m.pageUrl)}</small>`:""}
    </div></div>
    <button class="btn danger" data-remove="${i}">حذف</button>
  </div>`).join("");
  list.querySelectorAll("[data-remove]").forEach(b=>b.onclick=()=>{
    playlist.splice(+b.dataset.remove,1); renderMovies(); renderPlaylist();
  });
}

function renderPlaylist(){
  const box=$("playlistEditor");
  if(!playlist.length){box.innerHTML='<div class="empty">قائمة البث فارغة.</div>';return}
  box.innerHTML=playlist.map((m,i)=>`<div class="playlist-row">
    <div class="drag">☷</div>
    <input data-p-title="${i}" value="${esc(m.title||"")}">
    <input data-p-duration="${i}" type="number" min="1" value="${Number(m.durationSec||1)}">
    <button class="btn danger" data-p-remove="${i}">حذف</button>
  </div>`).join("");
  box.querySelectorAll("[data-p-remove]").forEach(b=>b.onclick=()=>{
    playlist.splice(+b.dataset.pRemove,1); renderPlaylist(); renderMovies();
  });
}

$("movieForm").onsubmit=async e=>{
  e.preventDefault();
  const rawAge = $("movieAgeRating").value;
  const age = rawAge ? normalizeAge(rawAge, false) : "";
  playlist.push(normalizeItem({
    title:$("movieTitle").value.trim(),
    category:$("movieCategory").value.trim() || "عام",
    description:$("movieDescription").value.trim(),
    pageUrl:$("moviePageUrl").value.trim(),
    url:$("movieUrl").value.trim(),
    posterUrl:$("moviePoster").value.trim(),
    durationSec:Number($("movieDuration").value||7200),
    kind:"MOVIE",
    ageRating:age,
    skipStartSec:Number($("skipStart").value||0),
    skipEndSec:Number($("skipEnd").value||0)
  }));
  renderMovies(); renderPlaylist(); e.target.reset();
  $("movieDuration").value=7200; $("movieAgeRating").value="+18";
  $("skipStart").value=0; $("skipEnd").value=0;
  toast("تمت إضافة الفيلم للقائمة المحلية — اضغط حفظ قائمة البث لنشره.");
};

$("moviePoster").oninput=e=>{const u=e.target.value; $("posterPreview").innerHTML=u?`<img src="${esc(u)}">`:"<span>أدخل رابط البوستر</span>";};
$("movieTitle").oninput=e=>$("previewMovieTitle").textContent=e.target.value||"اسم الفيلم";
$("movieCategory").oninput=e=>$("previewMovieCategory").textContent=e.target.value||"التصنيف";

$("savePlaylist").onclick=async()=>{
  document.querySelectorAll("[data-p-title]").forEach(x=>playlist[+x.dataset.pTitle].title=x.value.trim());
  document.querySelectorAll("[data-p-duration]").forEach(x=>playlist[+x.dataset.pDuration].durationSec=Math.max(1,Number(x.value||1)));

  const normalized=playlist.map(normalizeItem);
  const first=normalized[0];
  try{
    await setDoc(streamRef,{
      playlist:normalized,
      movieTitle:first?.title||"",
      title:first?.title||"",
      movieCategory:first?.category||"عام",
      category:first?.category||"عام",
      movieDescription:first?.description||"",
      description:first?.description||"",
      posterUrl:first?.posterUrl||"",
      moviePoster:first?.posterUrl||"",
      ageRating:first?.ageRating||"",
      is18Plus:first?.ageRating==="+18",
      durationSec:first?.durationSec||0,
      playbackState:stream.playbackState||"PLAYING",
      startedAt:serverTimestamp()
    },{merge:true});
    playlist=normalized; stream.playbackState=stream.playbackState||"PLAYING";
    toast("تم نشر قائمة البث ومزامنة القناة بنجاح");
    await loadStream();
  }catch(e){toast("فشل الحفظ: "+e.message)}
};

$("playBtn").onclick=()=>setPlayback("PLAYING");
$("pauseBtn").onclick=()=>setPlayback("PAUSED");
$("skipBtn").onclick=async()=>{
  if(playlist.length>1){
    playlist=playlist.slice(1).concat(playlist[0]);
    renderPlaylist(); renderMovies();
    await saveCurrentPlaylist(true);
  }
};

async function saveCurrentPlaylist(resetClock=false){
  const normalized=playlist.map(normalizeItem);
  const first=normalized[0];
  const data={
    playlist:normalized,
    movieTitle:first?.title||"",
    title:first?.title||"",
    movieCategory:first?.category||"عام",
    category:first?.category||"عام",
    movieDescription:first?.description||"",
    description:first?.description||"",
    posterUrl:first?.posterUrl||"",
    moviePoster:first?.posterUrl||"",
    ageRating:first?.ageRating||"",
    is18Plus:first?.ageRating==="+18",
    durationSec:first?.durationSec||0
  };
  if(resetClock) data.startedAt=serverTimestamp();
  await setDoc(streamRef,data,{merge:true});
  playlist=normalized;
  await loadStream();
}

async function setPlayback(state){
  try{
    const data={playbackState:state};
    if(!stream.startedAt) data.startedAt=serverTimestamp();
    await setDoc(streamRef,data,{merge:true});
    stream.playbackState=state; $("playState").textContent=state;
    toast("تم إرسال حالة "+state);
  }catch(e){toast("فشل تغيير حالة البث: "+e.message)}
}

$("brandingForm").onsubmit=async e=>{
  e.preventDefault();
  const data={logoUrl:$("logoUrl").value.trim(),channelLogoUrl:$("logoUrl").value.trim(),portTop:Number($("portTop").value),portRight:Number($("portRight").value),portWidth:Number($("portWidth").value),landTop:Number($("landTop").value),landRight:Number($("landRight").value),landWidth:Number($("landWidth").value)};
  try{await setDoc(streamRef,data,{merge:true});toast("تم حفظ إعدادات الشعار");}catch(e){toast("فشل الحفظ: "+e.message)}
};

$("bannerForm").onsubmit=async e=>{
  e.preventDefault();
  const data={
      topBannerUrl:$("topBannerUrl").value.trim(),
      bottomBannerUrl:$("bottomBannerUrl").value.trim(),
      topBannerTopPx:Number($("topBannerTop").value),
      topBannerWidth:Number($("topBannerWidth").value),
      topBannerActive:$("topBannerActive").checked,
      bottomBannerActive:$("bottomBannerActive").checked
    };
  try{await setDoc(streamRef,data,{merge:true});toast("تم حفظ البانرات");}catch(e){toast("فشل الحفظ: "+e.message)}
};

let ads=[];
$("adForm").onsubmit=async e=>{
  e.preventDefault();
  const ad=normalizeItem({
    title:$("adName").value.trim() || "فاصل إعلاني",
    url:$("adUrl").value.trim(),
    pageUrl:"",
    durationSec:Math.max(1,Number($("adAt").value||30)),
    kind:"AD",
    category:"إعلان",
    ageRating:"",
    posterUrl:"",
    bannerUrl:""
  });
  playlist.push(ad);
  renderAds(); renderPlaylist(); renderMovies();
  e.target.reset(); $("adActive").checked=true;
  toast("تمت إضافة الفاصل — احفظ قائمة البث لتطبيقه على البث المباشر.");
};

function renderAds(){
  $("adList").innerHTML=playlist.filter(x=>String(x.kind).toUpperCase()==="AD").map((a,i)=>`<div class="simple-item">
    <span><b>${esc(a.title)}</b><small class="muted"> مدة ${fmt(a.durationSec)}</small></span>
    <button class="btn danger" onclick="window.adsRemove(${i})">حذف</button>
  </div>`).join("") || '<div class="empty">لا توجد فواصل محفوظة بعد.</div>';
}
window.adsRemove=i=>{
  const adsOnly=playlist.map((x,idx)=>({x,idx})).filter(o=>String(o.x.kind).toUpperCase()==="AD");
  if(adsOnly[i]) playlist.splice(adsOnly[i].idx,1);
  renderAds(); renderPlaylist(); renderMovies();
};

let emergencies=[];
$("emergencyForm").onsubmit=e=>{e.preventDefault();emergencies.push({name:$("emName").value,url:$("emUrl").value});renderEmergencies();e.target.reset()};
function renderEmergencies(){$("emList").innerHTML=emergencies.length?emergencies.map((a,i)=>`<div class="simple-item"><span><b>${esc(a.name)}</b></span><button class="btn" onclick="window.launchSaved(${i})">تشغيل</button></div>`).join(""):'<div class="empty">لا توجد إعلانات طارئة.</div>'}
window.launchSaved=i=>launchEmergency(emergencies[i]);
$("launchEmergency").onclick=()=>{ if(emergencies[0]) launchEmergency(emergencies[0]); else toast("أضف إعلاناً طارئاً أولاً."); };

async function launchEmergency(ad){
  try{
    await setDoc(streamRef,{emergencyActive:true,emergencyUrl:ad.url,emergencyName:ad.name,emergencyLaunchedAt:serverTimestamp()}, {merge:true});
    $("emStatus").textContent="تم إطلاق: "+ad.name; toast("تم إرسال أمر الإعلان الطارئ");
  }catch(e){toast("فشل إطلاق الإعلان: "+e.message)}
}

$("prayerForm").onsubmit=async e=>{
  e.preventDefault();
  try{
    await setDoc(doc(db,"settings","prayer"),{athanEnabled:$("athanEnabled").checked,athanUrl:$("athanUrl").value.trim()},{merge:true});
    toast("تم حفظ إعدادات الأذان");
  }catch(e){toast("فشل الحفظ: "+e.message)}
};

async function loadComments(){
  const box=$("commentList");
  try{
    const q=query(collection(streamRef,"comments"),orderBy("timestamp","desc"),limit(25));
    const snap=await getDocs(q);
    if(snap.empty){box.innerHTML='<div class="empty">لا توجد تعليقات.</div>';return}
    box.innerHTML=snap.docs.map(d=>{const c=d.data();return `<div class="simple-item"><span><b>${esc(c.name||c.displayName||"مستخدم")}</b> <small class="muted">@${esc(c.username||"")}</small><br>${esc(c.text||"")}</span><button class="btn danger" data-comment="${d.id}">حذف</button></div>`}).join("");
    box.querySelectorAll("[data-comment]").forEach(b=>b.onclick=async()=>{try{await deleteDoc(doc(streamRef,"comments",b.dataset.comment));loadComments();toast("تم حذف التعليق")}catch(e){toast("فشل حذف التعليق: "+e.message)}});
  }catch(e){box.innerHTML=`<div class="empty">تعذر تحميل التعليقات: ${esc(e.message)}</div>`}
}
$("deleteComments").onclick=()=>toast("استخدم زر الحذف بجوار كل تعليق لتفادي الحذف الجماعي بالخطأ.");

$("refreshBtn").onclick=loadStream;
loadStream();
  </script>
</head>
<body>
  <div id="toast" class="toast"></div>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-mark">C</div>
        <div><strong>COBRA TV</strong><small>MASTER CONTROL</small></div>
      </div>

      <div class="live-chip"><span></span> النظام متصل</div>

      <nav id="nav">
        <button class="nav-item active" data-screen="dashboard">الرئيسية</button>
        <button class="nav-item" data-screen="movies">الأفلام</button>
        <button class="nav-item" data-screen="playlist">قائمة البث</button>
        <button class="nav-item" data-screen="ads">فواصل الإعلانات</button>
        <button class="nav-item" data-screen="emergency">الإعلانات الطارئة</button>
        <button class="nav-item" data-screen="branding">الشعار</button>
        <button class="nav-item" data-screen="banners">البانرات</button>
        <button class="nav-item" data-screen="prayer">الصلاة والأذان</button>
        <button class="nav-item" data-screen="users">الحسابات والتعليقات</button>
      </nav>

      <div class="side-footer">
        <div class="firebase-dot"><span></span> Firebase Connected</div>
        <div class="version">Cobra TV Control v1.0</div>
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <div>
          <h1 id="screenTitle">غرفة التحكم الرئيسية</h1>
          <p id="screenSubtitle">تحكم مباشر في البث والمحتوى</p>
        </div>
        <div class="top-actions">
          <div class="clock" id="clock">--:--:--</div>
          <button class="btn ghost" id="refreshBtn">تحديث</button>
        </div>
      </header>

      <section id="screen-dashboard" class="screen active">
        <div class="hero-grid">
          <div class="preview-card panel">
            <div class="panel-head"><span>المعاينة المباشرة</span><b class="on-air"><i></i> ON AIR</b></div>
            <div class="preview">
              <img id="dashPoster" src="" alt="">
              <div class="preview-overlay">
                <span id="dashCategory">—</span>
                <h2 id="dashTitle">لا يوجد محتوى</h2>
                <p id="dashDescription">بانتظار بيانات البث من Firebase</p>
              </div>
            </div>
            <div class="transport">
              <button class="btn danger" id="pauseBtn">إيقاف مؤقت</button>
              <button class="btn" id="playBtn">تشغيل</button>
              <button class="btn" id="skipBtn">تخطي</button>
            </div>
          </div>

          <div class="panel now-card">
            <div class="panel-head"><span>الآن على الهواء</span><span class="live-dot">● مباشر</span></div>
            <div class="now-title" id="nowTitle">—</div>
            <div class="progress-wrap">
              <div class="progress"><span id="progressBar"></span></div>
              <div class="time-row"><span id="elapsed">00:00</span><span id="duration">00:00</span></div>
            </div>
            <div class="next-box">
              <small>التالي</small>
              <strong id="nextTitle">—</strong>
              <span id="nextTime">—</span>
            </div>
            <div class="stats">
              <div><b id="viewerCount">0</b><small>مشاهد</small></div>
              <div><b id="likeCount">0</b><small>إعجاب</small></div>
              <div><b id="playlistCount">0</b><small>محتوى</small></div>
            </div>
          </div>
        </div>

        <div class="section-title">الحالة السريعة</div>
        <div class="cards-4">
          <div class="metric panel"><span>البث</span><b class="ok">يعمل</b><small id="playState">PLAYING</small></div>
          <div class="metric panel"><span>الشعار</span><b class="ok">مفعل</b><small>Portrait + Landscape</small></div>
          <div class="metric panel"><span>البانر العلوي</span><b id="bannerState">غير مفعل</b><small>Firebase</small></div>
          <div class="metric panel"><span>المحتوى القادم</span><b id="dashNextMetric">—</b><small>حسب قائمة البث</small></div>
        </div>
      </section>

      <section id="screen-movies" class="screen">
        <div class="form-grid">
          <form class="panel form-card" id="movieForm">
            <div class="panel-head"><span>إضافة فيلم</span><span class="badge">MOVIE</span></div>
            
            <!-- معلومات المحتوى الأساسية -->
            <div class="two">
              <label>اسم الفيلم<input id="movieTitle" required placeholder="مثال: فيلم Cobra"></label>
              <label>التصنيف<input id="movieCategory" placeholder="أكشن / رعب / كوميدي"></label>
            </div>
            
            <label>الوصف<textarea id="movieDescription" rows="3" placeholder="اكتب نبذة أو قصة الفيلم هنا..."></textarea></label>
            
            <!-- قسم الروابط الموحد والمتناسق -->
            <label>رابط صفحة السورس الثابتة (EgyBest Page URL)<input id="moviePageUrl" type="url" placeholder="https://iegybest.cimawbas.tv/play.php?vid=..."></label>
            
            <div class="two">
              <label>رابط الفيديو المباشر (m3u8 مؤقت - اختياري)<input id="movieUrl" type="url" placeholder="اتركه فارغاً للسحب التلقائي عبر السحابة"></label>
              <label>رابط البوستر<input id="moviePoster" type="url" placeholder="https://.../poster.jpg"></label>
            </div>
            
            <!-- التوقيت والتصنيف العمري -->
            <div class="two">
              <label>مدة العرض (ثانية)<input id="movieDuration" type="number" min="1" value="7200" required></label>
              <label>التصنيف العمري
                <select id="movieAgeRating">
                  <option value="">عام (بدون قيود)</option>
                  <option value="+13">+13 (مناسب للمراهقين)</option>
                  <option value="+16">+16 (فوق 16 سنة)</option>
                  <option value="+18" selected>+18 (للكبار فقط)</option>
                  <option value="+21">+21 (فوق 21 سنة)</option>
                </select>
              </label>
            </div>
            
            <div class="two">
              <label>تخطي من البداية (ثانية)<input id="skipStart" type="number" min="0" value="0"></label>
              <label>تخطي من النهاية (ثانية)<input id="skipEnd" type="number" min="0" value="0"></label>
            </div>
            
            <button class="btn primary" type="submit">حفظ الفيلم</button>
          </form>

          <div class="panel form-card">
            <div class="panel-head"><span>معاينة</span><span class="muted">Poster</span></div>
            <div class="poster-preview" id="posterPreview"><span>أدخل رابط البوستر</span></div>
            <div class="preview-meta"><b id="previewMovieTitle">اسم الفيلم</b><small id="previewMovieCategory">التصنيف</small></div>
          </div>
        </div>
        <div class="section-title">الأفلام المحفوظة</div>
        <div id="movieList" class="media-list"></div>
      </section>

      <section id="screen-playlist" class="screen">
        <div class="panel">
          <div class="panel-head"><span>جدول البث</span><button class="btn primary" id="savePlaylist">حفظ قائمة البث</button></div>
          <div id="playlistEditor" class="playlist-editor"></div>
        </div>
      </section>

      <section id="screen-ads" class="screen">
        <div class="form-grid">
          <form class="panel form-card" id="adForm">
            <div class="panel-head"><span>فواصل الإعلانات</span><span class="badge">AD BREAKS</span></div>
            <label>اسم ملف الإعلانات<input id="adName" placeholder="إعلانات الفاصل الأول"></label>
            <label>رابط فيديو الإعلانات<input id="adUrl" type="url" placeholder="https://..."></label>
            <label>مدة الفاصل بالثواني<input id="adAt" type="number" min="0" placeholder="مثال: 900"></label>
            <label class="switch-row"><span>تفعيل الفاصل</span><input id="adActive" type="checkbox" checked><i></i></label>
            <button class="btn primary" type="submit">إضافة الفاصل</button>
          </form>
          <div class="panel info-card">
            <div class="panel-head"><span>طريقة التشغيل</span></div>
            <div class="flow"><b>الفيلم</b><i>→</i><b>الفاصل</b><i>→</i><b>استكمال نفس الموضع</b></div>
            <p>اللوحة تسجل نقطة الفاصل. تنفيذ التشغيل الفعلي يتم من تطبيق Cobra TV بشكل متزامن.</p>
          </div>
        </div>
        <div class="section-title">الفواصل المحفوظة</div>
        <div id="adList" class="simple-list"></div>
      </section>

      <section id="screen-emergency" class="screen">
        <div class="panel emergency-panel">
          <div>
            <span class="badge danger-badge">EMERGENCY</span>
